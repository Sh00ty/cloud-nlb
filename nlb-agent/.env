NODE_ID="dpl-node-1"

ETCD_ENDPOINT="localhost:2379"
TTL_UNTIL_NODE_DEATH="5s"

PERSISTENT_STORAGE_PATH_TEMPLATE="/tmp/nlb-agent/dpl-%s"

MAX_RECONCILE_ATTEMPTS="3"
FORCE_RECONCILE_INTERVAL="30s"
RECONCILER_CONCURRENCY="5"

CONTROL_PLANE_ADDR="control-plane-apiserver.local:30080"
CONTROL_PLANE_LONG_POLL_DURATION="20s"

ENDPOINTS_SERVICE_ADDR="hc-server.local:30080"
ENDPOINT_STATUSES_RESYNC_INTERVAL="1m"

QUEUE_ADDR="127.0.0.1:19092"
QUEUE_ENDPOINT_STATUSES_TOPIC="dbserver1.public.target_statuses"

DEBUG="true"

LOGGER_LEVEL="INFO"
LOGGER_USE_PRETTY="true"
METRICS_ADDR="127.0.0.1:9101"